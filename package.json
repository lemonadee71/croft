{
  "name": "@lemonadee/croft",
  "version": "1.1.1",
  "description": "A lightweight, decoupled, native DOM reactive templating engine",
  "homepage": "https://lemonadee71.github.io/croft",
  "bugs": {
    "url": "https://github.com/lemonadee71/croft/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonadee71/croft.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src tests",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "version-packages": "changeset version",
    "dev": "concurrently -n docs,example -c blue,green 'pnpm dev:docs' 'pnpm dev:example'",
    "dev:docs": "pnpm --filter docs dev",
    "docs:prebuild": "pnpm build && pnpm --filter example build && mkdir -p docs/public && rm -rf docs/public/example && cp -r example/dist docs/public/example && (test -f CHANGELOG.md && cp CHANGELOG.md docs/ || true)",
    "docs:build": "pnpm docs:prebuild && pnpm --filter docs build",
    "dev:example": "pnpm --filter example dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "concurrently": "^9.2.3",
    "jsdom": "^22.1.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@11.5.2"
}
